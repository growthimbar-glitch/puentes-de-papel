{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	root * {{.StaticFileRoot}}

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html

	# La version de Railpack que corre en Railway no trae este bloque: sin el, apagar
	# el index_fallback deja las rutas inexistentes en un 404 de cuerpo vacio.
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
