---
import type { CollectionEntry } from 'astro:content';
import { ArrowRight, CalendarDays } from 'lucide-astro';

interface Props {
  post: CollectionEntry<'noticias'>;
}

const { post } = Astro.props;

// En UTC: pubDate se parsea a medianoche UTC y en UTC-3 se correría un día atrás.
const dateFormatter = new Intl.DateTimeFormat('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<a href={`/noticias/${post.id}/`} class="group block sr-fade-up-delayed">
  <article class="bg-white border border-[#A65F4C]/10 rounded-[2rem] overflow-hidden shadow-sm h-full flex flex-col hover:shadow-md hover:border-[#DD8574]/30 hover:-translate-y-1 transition-all duration-300">
    <div class="p-6 flex flex-col flex-1">
      <p class="inline-flex items-center gap-1.5 text-xs font-bold text-[#A65F4C] uppercase tracking-wider mb-3">
        <CalendarDays class="w-4 h-4" />
        {dateFormatter.format(post.data.pubDate)}
      </p>
      <h3 class="text-xl font-bold text-slate-900 mb-2 leading-snug">{post.data.title}</h3>
      <p class="text-slate-600 leading-relaxed font-light flex-1">{post.data.description}</p>
      <span class="mt-5 inline-flex items-center gap-2 font-bold text-[#A65F4C] group-hover:gap-3 transition-all">
        Leer nota
        <ArrowRight class="w-5 h-5" />
      </span>
    </div>
  </article>
</a>
