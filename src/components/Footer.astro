---
import { Image } from 'astro:assets';
import { Mail, ExternalLink } from 'lucide-astro';
import { SITE, NAV_LINKS, SOCIALS, CONTACT } from '../consts';

const year = new Date().getFullYear();
const activeSocials = SOCIALS.filter((s) => s.url && s.url.length > 0);
---

<footer class="bg-[#FCF6F8] border-t border-slate-100 pt-16 pb-10">
  <div class="contenedor">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      <!-- Marca + descripción -->
      <div class="lg:col-span-1">
        <div class="bg-transparent flex items-center mb-4">
          <Image
            src="/images/logo-horizontal.webp"
            width={224}
            height={56}
            alt="Logo de Puentes de Papel"
            class="w-52 object-contain mix-blend-multiply"
          />
        </div>
        <p class="text-slate-500 leading-relaxed text-sm max-w-xs">
          {SITE.tagline} Un proyecto de{' '}
          <a href={SITE.orgUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-[#A65F4C] hover:text-[#DD8574] transition-colors">
            {SITE.org}
          </a>.
        </p>
      </div>

      <!-- Navegación -->
      <nav aria-label="Navegación del pie de página">
        <h3 class="text-xs font-extrabold uppercase tracking-widest text-slate-400 mb-5">Navegación</h3>
        <ul class="space-y-3">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-slate-600 hover:text-[#A65F4C] transition-colors font-medium">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contacto -->
      <div>
        <h3 class="text-xs font-extrabold uppercase tracking-widest text-slate-400 mb-5">Contacto</h3>
        <ul class="space-y-3">
          <li>
            <a
              href={CONTACT.emailHref}
              class="inline-flex items-center gap-2 text-slate-600 hover:text-[#A65F4C] transition-colors font-medium break-all"
            >
              <Mail class="w-4 h-4 shrink-0 text-[#A65F4C]" />
              {CONTACT.email}
            </a>
          </li>
          <li>
            <a
              href={SITE.orgUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-slate-600 hover:text-[#A65F4C] transition-colors font-medium"
            >
              <ExternalLink class="w-4 h-4 shrink-0 text-[#A65F4C]" />
              {SITE.org}
            </a>
          </li>
          <li>
            <a href="/voluntariado-adultos-mayores/" class="text-slate-600 hover:text-[#A65F4C] transition-colors font-medium">
              Quiero colaborar
            </a>
          </li>
        </ul>
      </div>

      <!-- Redes -->
      <div>
        <h3 class="text-xs font-extrabold uppercase tracking-widest text-slate-400 mb-5">Seguinos</h3>
        {activeSocials.length > 0 ? (
          <div class="flex items-center gap-3">
            {activeSocials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                title={social.label}
                class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:text-[#A65F4C] hover:border-[#A65F4C]/40 hover:-translate-y-0.5 transition-all duration-300"
              >
                {social.icon === 'instagram' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                  </svg>
                )}
                {social.icon === 'tiktok' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
                  </svg>
                )}
                {social.icon === 'linkedin' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-9h4v1.5"></path>
                    <rect width="4" height="12" x="2" y="9"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                )}
              </a>
            ))}
          </div>
        ) : (
          <p class="text-slate-400 text-sm">Muy pronto en redes sociales.</p>
        )}
      </div>
    </div>

    <!-- Legales -->
    <div class="mt-14 pt-8 border-t border-slate-200/70 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <p class="text-slate-500 text-sm font-medium">
        &copy; {year} {SITE.name}. Un proyecto de {SITE.org}. Todos los derechos reservados.
      </p>
      <p class="text-slate-400 text-xs">
        Hecho con cariño para conectar generaciones.
      </p>
    </div>
  </div>
</footer>
