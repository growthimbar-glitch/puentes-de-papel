---
import { Image } from 'astro:assets';
import { Menu, Send } from 'lucide-astro';
import { NAV_LINKS, FORMS } from '../consts';

const rawPath = Astro.url.pathname;
const currentPath = rawPath !== '/' ? rawPath.replace(/\/$/, '') : '/';

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/');
---

<header class="sticky top-0 z-50 bg-[#F2EADD]/85 backdrop-blur-md border-b border-[#A65F4C]/10">
  <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl py-4">
    <div class="flex justify-between items-center gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Ir al inicio de Puentes de Papel">
        <div class="w-36 sm:w-40 bg-transparent flex items-center justify-center">
          <Image
            src="/images/logo-horizontal.webp"
            width={192}
            height={48}
            alt="Logo de Puentes de Papel"
            class="w-full h-full object-contain mix-blend-multiply"
          />
        </div>
      </a>

      <!-- Navegación desktop -->
      <nav class="hidden lg:flex items-center gap-5 lg:gap-6 font-semibold text-slate-600" aria-label="Navegación principal">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-[#A65F4C]',
              isActive(link.href) ? 'text-[#A65F4C] border-b-2 border-[#A65F4C] pb-0.5' : '',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA + botón menú móvil -->
      <div class="flex items-center gap-3">
        <a
          href="/voluntariado-adultos-mayores"
          class="hidden sm:inline-flex items-center gap-2 bg-[#A65F4C] text-white text-sm font-bold px-5 py-2.5 rounded-full hover:bg-[#DD8574] hover:-translate-y-0.5 transition-all duration-300 btn-shine"
        >
          Quiero participar
          <Send class="w-4 h-4" />
        </a>
        <label
          for="alternar-menu"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-full bg-white shadow-sm border border-slate-200 text-slate-700 hover:bg-[#F2EADD] hover:text-[#A65F4C] transition-colors cursor-pointer"
          aria-label="Abrir menú de navegación"
        >
          <Menu class="w-6 h-6" />
        </label>
      </div>
    </div>

    <!-- Menú móvil -->
    <input id="alternar-menu" type="checkbox" class="peer hidden" />
    <nav
      class="mt-4 bg-white rounded-2xl shadow-lg p-4 space-y-2 peer-checked:block hidden lg:hidden"
      aria-label="Navegación principal móvil"
    >
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'block px-3 py-2 rounded-xl font-semibold transition-colors hover:bg-[#F2EADD] hover:text-[#A65F4C]',
            isActive(link.href) ? 'bg-[#F2EADD] text-[#A65F4C]' : 'text-slate-700',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={FORMS.voluntarios}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 flex items-center justify-center gap-2 bg-[#A65F4C] text-white font-bold px-4 py-2.5 rounded-full hover:bg-[#DD8574] transition-colors"
      >
        Quiero ser voluntario/a
        <Send class="w-4 h-4" />
      </a>
    </nav>
  </div>
</header>
