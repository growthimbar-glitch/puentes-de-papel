---
import '../styles/global.css';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import { jsonLdString } from '../seo';
import { SITE, OG_IMAGES, OG_IMAGE_DEFAULT } from '../consts';

interface Props {
  title: string;
  description: string;
  canonicalURL?: URL | string;
  ogImage?: string;
  /** Pisa el alt de OG_IMAGES; las notas mandan el suyo, más específico. */
  ogImageAlt?: string;
  showScrollProgress?: boolean;
  showAnimations?: boolean;
  themeColor?: string;
  /** Para páginas que no deben indexarse (404, gracias, etc.). */
  robots?: string;
  /** 'article' en las notas; 'website' en el resto. */
  ogType?: 'website' | 'article';
  /** Solo para ogType='article'. Fechas ISO. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Nodos JSON-LD propios de la página (NewsArticle, BreadcrumbList, etc.). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalURL,
  ogImage,
  ogImageAlt,
  showScrollProgress = false,
  showAnimations = false,
  themeColor = "#A65F4C",
  robots = 'index, follow',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = []
} = Astro.props;

const siteOrigin = Astro.site || SITE.url;

const actualCanonicalURL = canonicalURL || new URL(Astro.url.pathname, siteOrigin);

const ogImagePath = ogImage || OG_IMAGE_DEFAULT;
const actualOgImage = new URL(ogImagePath, siteOrigin).href;
const ogImageMeta = OG_IMAGES[ogImagePath];
const actualOgImageAlt = ogImageAlt || ogImageMeta?.alt;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PMWWXQ7D');</script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={actualCanonicalURL} />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="XZjzNmStu4AUY2NzGIwVKuKnyxP4eKNU8jyPcojMx4A" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={actualCanonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={actualOgImage} />
    {ogImageMeta && (
      <>
        <meta property="og:image:width" content={String(ogImageMeta.width)} />
        <meta property="og:image:height" content={String(ogImageMeta.height)} />
      </>
    )}
    {actualOgImageAlt && <meta property="og:image:alt" content={actualOgImageAlt} />}
    <meta property="og:locale" content="es_AR" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={actualCanonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={actualOgImage} />
    {actualOgImageAlt && <meta name="twitter:image:alt" content={actualOgImageAlt} />}

    <!-- Datos estructurados: se arma en src/seo.ts -->
    <script type="application/ld+json" is:inline set:html={jsonLdString(jsonLd)} />

    <!-- SEO adicional -->
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={themeColor} />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/images/logo.webp" />

    {showScrollProgress && (
      <script is:inline>
        if (typeof window !== 'undefined') {
          window.addEventListener('DOMContentLoaded', () => {
            const progress = document.getElementById('scroll-progress');
            window.addEventListener('scroll', () => {
              const winScroll = document.documentElement.scrollTop;
              const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
              const scrolled = winScroll / height;
              if (progress) {
                progress.style.transform = `scaleX(${scrolled})`;
              }
            });
          });
        }
      </script>
    )}

    {showAnimations && (
      <script is:inline>
        if (typeof window !== 'undefined') {
          window.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('sr-visible');
                    observer.unobserve(entry.target);
                  }
                });
              },
              {
                threshold: 0.15,
              }
            );

            document
              .querySelectorAll('.sr-fade-up, .sr-fade-up-delayed, .sr-stagger-item')
              .forEach((el) => observer.observe(el));
          });
        }
      </script>
    )}
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PMWWXQ7D"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    {showScrollProgress && (
      <div class="fixed top-0 left-0 w-full h-[3px] bg-gradient-to-r from-[#A65F4C] via-[#DD8574] to-[#F2EADD] z-[60] origin-left scale-x-0 transition-transform duration-75" id="scroll-progress"></div>
    )}

    <Navbar />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
  </body>
</html>