---
import { getCollection } from 'astro:content';
import { Heart, Users, Building, Newspaper, BookOpen, Sparkles, ArrowRight, Send, MailOpen, PenLine } from 'lucide-astro';
import BaseLayout from '../components/BaseLayout.astro';
import Card from '../components/Card.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import { FORMS, CIFRAS } from '../consts';

const title = 'Puentes de Papel | Voluntariado intergeneracional en Córdoba';
const description = 'Voluntariado intergeneracional en Córdoba y en todo el país: Puentes de Papel conecta jóvenes y personas mayores a través de cartas. Conocé cómo sumarte.';
const ogImage = '/images/puentes-de-papel-conversacion-parque-adulto-mayor-voluntaria.webp';

// Tarjetas de navegación hacia las páginas principales.
const secciones = [
  {
    href: '/sobre-el-proyecto/',
    icon: BookOpen,
    eyebrow: 'Conocé la iniciativa',
    title: 'Sobre el proyecto',
    text: 'Nuestra historia, misión, valores y el equipo que sostiene cada carta y cada encuentro.',
  },
  {
    href: '/voluntariado-adultos-mayores/',
    icon: Heart,
    eyebrow: 'Sumate',
    title: 'Formas de participar',
    text: 'Voluntariado, participación como persona mayor, donaciones y otras maneras de colaborar.',
  },
  {
    href: '/instituciones-residencias/',
    icon: Building,
    eyebrow: 'Trabajemos juntos',
    title: 'Instituciones',
    text: 'Residencias, hogares, escuelas, empresas y organizaciones que quieren construir puentes.',
  },
  {
    href: '/noticias/',
    icon: Newspaper,
    eyebrow: 'Novedades',
    title: 'Noticias',
    text: 'Encuentros, historias y novedades de nuestra comunidad intergeneracional.',
  },
];

// Las tres dudas que más frenan a alguien que está por anotarse.
const reparos = [
  {
    title: 'Sin experiencia previa',
    text: 'No hace falta formación previa. La capacitación inicial te prepara para empezar.',
  },
  {
    title: 'Una carta por mes',
    text: 'El intercambio es mensual o cada quince días. No hay horarios fijos.',
  },
  {
    title: 'Con acompañamiento',
    text: 'El equipo coordina con la residencia y está para lo que necesites.',
  },
];

// Los tres lados del intercambio, en el orden en que importan: quien recibe, quien escribe, el resto.
const beneficios = [
  {
    icon: MailOpen,
    title: 'Qué gana la persona mayor',
    text: 'Compañía que no depende de que alguien pueda venir. La soledad no deseada es una de las cosas que más pesa en la vejez, y no se resuelve con una visita suelta: se resuelve sabiendo que alguien va a volver a escribir. A eso se suma algo que no siempre aparece: alguien que pregunta por su historia y espera la respuesta. Después de toda una vida, que alguien quiera escuchar no es poco.',
  },
  {
    icon: PenLine,
    title: 'Qué gana quien escribe',
    text: 'Para muchos voluntarios es su primera experiencia de voluntariado social, y es de las formas más accesibles de empezar: no hay que formarse durante meses ni cumplir un horario. Lo que se aprende en el camino cuesta más de conseguir. Escuchar de verdad. Escribir para alguien concreto. Y descubrir que la vejez no se parece casi en nada al estereotipo con el que uno llegó: eso tiene nombre, se llama viejismo, y se desarma conociendo gente.',
  },
  {
    icon: Users,
    title: 'Qué gana la comunidad',
    text: 'Cada dupla es un vínculo que no existía y que, sin el programa, no se habría dado nunca: dos personas que no comparten barrio, ni familia, ni edad. Cuando esos vínculos se multiplican, la vejez deja de ser un lugar aparte al que se llega solo. A eso apunta el envejecimiento activo: seguir participando, seguir teniendo a quién contarle las cosas.',
  },
];

const impacto = [
  { icon: Users, valor: CIFRAS.voluntarios, label: 'Voluntarios' },
  { icon: Building, valor: CIFRAS.residencias, label: 'Residencias e instituciones' },
  { icon: Heart, valor: `+${CIFRAS.personasMayores}`, label: 'Personas mayores acompañadas' },
];

const ultimasNoticias = (await getCollection('noticias', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const pasos = [
  {
    title: 'Te inscribís',
    text: 'Completás el formulario de voluntariado y nos contás un poco sobre vos: qué te gusta, de qué te gustaría escribir.',
  },
  {
    title: 'Te vinculamos con una persona mayor',
    text: 'Coordinamos con la residencia y te asignamos un adulto mayor. Recibís una capacitación inicial y las pautas para escribir la primera carta.',
  },
  {
    title: 'Escribís y tu carta llega',
    text: 'Escribís a mano y nosotros nos ocupamos de que llegue a destino. La respuesta vuelve por el mismo camino.',
  },
  {
    title: 'El vínculo se sostiene',
    text: 'El intercambio continúa en el tiempo y muchas veces termina en un encuentro. De ahí nacen los vínculos que combaten la soledad en la vejez.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  showScrollProgress={true}
  showAnimations={true}
>
  <div class="font-sans text-slate-800 overflow-hidden">
    <!-- --- 1. Hero Section --- -->
    <div class="bg-[#F2EADD]">
      <section class="contenedor pt-12 pb-24 md:pt-20 md:pb-32 relative">
        <!-- Decorative Background Blobs -->
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#DD8574] rounded-full mix-blend-multiply filter blur-[128px] opacity-30"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-amber-200 rounded-full mix-blend-multiply filter blur-[128px] opacity-40"></div>

        <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20 relative z-10">

          <!-- Left Column: Text -->
          <div class="w-full md:w-1/2 flex flex-col items-start text-left animate-fade-slide-up" style="animation-delay: 150ms;">
            <div class="inline-flex items-center gap-2 bg-white border border-[#DD8574]/40 px-4 py-2 rounded-full mb-6">
              <span class="flex h-2 w-2 rounded-full bg-[#A65F4C]"></span>
              <span class="text-sm font-bold text-[#A65F4C] tracking-wide uppercase">Un proyecto de Munay Ruray</span>
            </div>

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 leading-[1.1] mb-6">
              Puentes de Papel: <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#A65F4C] to-[#DD8574]">Cartas que unen generaciones</span>
            </h1>


            <h2 class="text-xl md:text-2xl font-semibold text-slate-600 mb-6 leading-relaxed">
              Un voluntariado intergeneracional que une a jóvenes y personas mayores, carta a carta.
            </h2>

            <p class="text-xl text-slate-500 mb-10 leading-relaxed max-w-xl">
              Puentes de Papel nació en Córdoba, Argentina, y hoy llega a residencias de tres
              provincias. A través del intercambio de cartas creamos espacios de encuentro que
              combaten la soledad en la vejez: nacen vínculos que acompañan, y muchas veces también amistades.
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-6 w-full sm:w-auto">
              <a href="/voluntariado-adultos-mayores/" class="cursor-pointer w-full sm:w-auto bg-[#A65F4C] text-white text-lg font-bold px-8 py-4 rounded-full hover:bg-[#DD8574] hover:-translate-y-1 transition-all duration-300 btn-shine text-center">
                Descubre cómo participar
              </a>
              <a href="/sobre-el-proyecto/" class="cursor-pointer w-full sm:w-auto group flex items-center justify-center gap-3 text-slate-700 font-bold text-lg hover:text-[#A65F4C] transition-colors">
                <div class="w-12 h-12 rounded-full bg-white border border-slate-100 flex items-center justify-center group-hover:bg-[#F2EADD] transition-colors">
                  <Sparkles class="w-5 h-5 text-[#A65F4C]" />
                </div>
                Conocer más
              </a>
            </div>
          </div>

          <!-- Right Column: Image/Illustration -->
          <div class="w-full md:w-1/2 relative animate-hero-img-in mt-10 md:mt-0" style="animation-delay: 300ms;">
            <!-- Floating decorative elements -->
            <div class="absolute -top-4 -left-2 md:-top-8 md:-left-8 bg-white border border-slate-100 p-2.5 md:p-3 rounded-2xl z-20">
              <Sparkles class="w-6 h-6 md:w-8 md:h-8 text-amber-400" />
            </div>
            <div class="absolute -bottom-4 -right-2 md:-bottom-6 md:-right-6 bg-white border border-slate-100 p-3 md:p-4 rounded-full z-20">
              <Heart class="w-6 h-6 md:w-8 md:h-8 text-rose-400 fill-rose-400" />
            </div>

            <!-- Main Image Masked -->
            <div class="relative rounded-[2rem] md:rounded-[3rem] overflow-hidden border-4 md:border-8 border-white">
              <div class="absolute inset-0 bg-[#A65F4C]/10 mix-blend-overlay z-10"></div>
              <img
                src="/images/puentes-de-papel-conversacion-parque-adulto-mayor-voluntaria.webp"
                srcset="/images/puentes-de-papel-conversacion-parque-adulto-mayor-voluntaria-800.webp 800w, /images/puentes-de-papel-conversacion-parque-adulto-mayor-voluntaria-1200.webp 1200w, /images/puentes-de-papel-conversacion-parque-adulto-mayor-voluntaria.webp 1600w"
                sizes="(min-width: 1440px) 672px, (min-width: 768px) 50vw, 100vw"
                width={600}
                height={500}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                alt="Un adulto mayor y una joven voluntaria conversan animadamente sentados en una banca de parque durante un encuentro de voluntariado intergeneracional del proyecto Puentes de Papel"
                title="Joven voluntaria conversando con adulto mayor en parque — Puentes de Papel"
                aria-label="Encuentro intergeneracional al aire libre en el proyecto Puentes de Papel de Munay Ruray, donde jóvenes escuchan y acompañan a personas mayores en el rescate de sus memorias."
                role="img"
                class="w-full h-[300px] sm:h-[400px] md:h-[500px] object-cover object-center transform hover:scale-105 transition-transform duration-700"
              />
            </div>
          </div>

        </div>
      </section>
    </div>

    <!-- --- 2. Qué hacemos / qué es el voluntariado intergeneracional --- -->
    <section class="py-24 md:py-28 bg-white sr-fade-up">
      <div class="contenedor">
        <!-- Frase de apertura centrada, con el degradado de marca del H1. -->
        <div class="max-w-5xl mx-auto text-center mb-20 md:mb-24">
          <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Qué hacemos</span>
          <p class="text-3xl md:text-4xl lg:text-5xl font-black text-slate-900 leading-[1.2] text-balance mt-3">
            Hay una carta que llega a una residencia, se lee dos veces y
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#A65F4C] to-[#DD8574]">se guarda en la mesa de luz</span>.
          </p>

          <div class="grid md:grid-cols-2 gap-8 lg:gap-14 text-left text-lg md:text-xl text-slate-600 leading-relaxed font-light text-pretty mt-12">
            <p>
              Eso es lo que buscamos: que una hoja de papel sea compañía para alguien que la espera.
            </p>
            <p>
              Puentes de Papel conecta a jóvenes voluntarios con personas mayores de residencias de
              Córdoba, Santa Fe y Buenos Aires, a través de un intercambio de cartas escritas a mano.
            </p>
          </div>
        </div>

        <div class="border-t border-[#A65F4C]/10 pt-16 md:pt-20">
          <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-start">
            <h2 class="lg:col-span-5 text-3xl md:text-4xl font-black text-slate-900 leading-tight text-pretty">
              ¿Qué es el voluntariado intergeneracional?
            </h2>

            <p class="lg:col-span-7 lg:col-start-6 text-xl md:text-2xl text-slate-700 leading-relaxed text-pretty border-l-2 border-[#A65F4C]/30 pl-5">
              Es una forma de voluntariado social en la que personas de distintas edades comparten
              tiempo, historias y afecto de manera sostenida. No hace falta una formación previa ni
              una disponibilidad rígida: hace falta ganas de escuchar.
            </p>
          </div>

          <div class="space-y-6 text-lg md:text-xl text-slate-600 leading-relaxed text-pretty mt-12 md:mt-14">
            <p>
              Lo que lo distingue de una visita suelta o de una actividad de un día es la continuidad.
              El vínculo no se agota en un encuentro: se construye de a poco, con el ida y vuelta, hasta
              que las dos personas empiezan a esperar la próxima carta.
            </p>
            <p>
              En Puentes de Papel lo hacemos a través de cartas escritas a mano. Cada voluntario le
              escribe a una persona mayor de una residencia, y esa correspondencia se sostiene en el
              tiempo. No hace falta vivir en la misma ciudad: las residencias están en Córdoba, Santa Fe
              y Buenos Aires, y se escribe desde cualquier provincia del país.
            </p>
            <p>
              La capacitación inicial cubre lo que hay que saber: cómo escuchar, cómo cuidar la
              intimidad del otro y cómo iniciar el intercambio. Para mucha gente es su primer
              voluntariado, y empieza con algo tan simple como contar cómo fue la semana y
              preguntar por la del otro.
            </p>
            <p>
              Y funciona en las dos direcciones. Es fácil pensar el voluntariado como algo que uno da;
              en la práctica, cada carta vuelve con algo adentro.
            </p>
          </div>

          <ul class="grid sm:grid-cols-3 gap-6 mt-14">
            {reparos.map((reparo, i) => (
              <li>
                <Card variant="stamp" as="div" staggerDelay={i * 90} class="h-full text-center">
                  <h3 class="text-lg font-black text-[#A65F4C] mb-2">{reparo.title}</h3>
                  <p class="text-slate-600 leading-relaxed font-light">{reparo.text}</p>
                </Card>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- --- 3. Qué gana cada generación --- -->
    <section class="py-24 md:py-28 bg-[#FCF9F5] border-y border-orange-100/50 sr-fade-up">
      <div class="contenedor">
        <!-- Alineado a la izquierda a propósito: viene después de dos bloques centrados. -->
        <div class="max-w-3xl mb-16 md:mb-20">
          <!-- La keyword vive en el eyebrow: el H2 de arriba ya la tiene exacta y repetirla acá sonaba a relleno. -->
          <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Beneficios del voluntariado intergeneracional</span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 leading-[1.15] text-pretty mt-2 mb-6">
            ¿Qué gana cada generación?
          </h2>
          <p class="text-xl text-slate-600 leading-relaxed font-light text-pretty">
            No es un favor que una generación le hace a la otra. Es un intercambio, y cada parte se
            lleva algo distinto.
          </p>
        </div>

        <ul class="grid md:grid-cols-3 gap-10 lg:gap-14">
          {beneficios.map((beneficio) => (
            <li class="border-t-2 border-[#A65F4C]/15 pt-8 sr-fade-up-delayed">
              <beneficio.icon class="w-8 h-8 text-[#A65F4C] mb-5" />
              <h3 class="text-2xl font-bold text-slate-900 mb-3 text-balance">{beneficio.title}</h3>
              <p class="text-lg text-slate-600 leading-relaxed font-light text-pretty">{beneficio.text}</p>
            </li>
          ))}
        </ul>

        <p class="text-center text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto mt-16">
          Nada de esto pasa en una tarde. Funciona cuando el vínculo se sostiene: por eso lo que
          pedimos no es tiempo, es continuidad. Si te interesa, mirá{' '}
          <a href="/voluntariado-adultos-mayores/" class="font-bold text-[#A65F4C] hover:text-[#DD8574] transition-colors underline decoration-2 underline-offset-4">cómo sumarte al voluntariado</a>.
        </p>
      </div>
    </section>

    <!-- --- 4. Por qué cartas --- -->
    <section class="py-24 md:py-28 bg-[#F2EADD] relative overflow-hidden sr-fade-up">
      <div class="absolute -left-32 top-1/4 w-96 h-96 bg-[#DD8574] rounded-full mix-blend-multiply filter blur-[128px] opacity-25 pointer-events-none"></div>

      <div class="contenedor relative z-10">
        <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">
          <div>
            <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">La carta</span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 leading-tight text-pretty mt-2 mb-6">
              ¿Por qué cartas?
            </h2>
            <div class="space-y-5 text-lg md:text-xl text-slate-700 leading-relaxed font-light text-pretty">
              <p>
                Porque muchas residencias no reciben visitas frecuentes, y una carta llega igual.
                Se relee, se guarda, se muestra a otros: acompaña mucho más allá del momento en que
                se escribió.
              </p>
              <p>
                Escribir a mano también obliga a detenerse y a elegir las palabras, y eso se nota
                del otro lado.
              </p>
              <p>
                Es, además, una forma de{' '}
                <a href="/voluntariado-adultos-mayores/" class="font-bold text-[#A65F4C] hover:text-[#DD8574] transition-colors underline decoration-2 underline-offset-4">voluntariado con adultos mayores</a>{' '}
                que no depende de coincidir en un horario ni de vivir cerca.
              </p>
            </div>
          </div>

          <div class="sr-fade-up-delayed">
            <div class="relative max-w-lg mx-auto lg:mx-0 lg:ml-auto">
              <!-- Hoja de atrás: sugiere que la correspondencia se acumula. -->
              <div class="absolute inset-0 bg-white/60 border border-[#A65F4C]/10 rounded-sm rotate-[3deg] translate-x-3 translate-y-3"></div>

              <div class="relative bg-white border border-[#A65F4C]/15 rounded-sm shadow-[0_20px_45px_-20px_rgba(59,30,22,0.4)] -rotate-[1.5deg] p-8 md:p-10 hover:rotate-0 transition-transform duration-500">
                <!-- Estampilla -->
                <div class="absolute top-7 right-7 w-14 h-16 md:w-16 md:h-20 border-2 border-dashed border-[#A65F4C]/30 rounded-sm flex items-center justify-center bg-[#FCF9F5]">
                  <Heart class="w-6 h-6 md:w-7 md:h-7 text-[#DD8574] fill-[#DD8574]/40" />
                </div>

                <p class="font-serif-literary italic text-[#A65F4C] text-lg mb-8">Córdoba, Argentina</p>

                <div class="papel-carta font-serif-literary text-xl md:text-2xl text-slate-700 leading-8 space-y-8 pr-16 md:pr-20">
                  <p>Querida Elena:</p>
                  <p>
                    Esta semana empecé la facultad y pensé en vos, que siempre me decís que estudiar es "el mejor lugar para guardar las cosas". Ojalá tengas razón.
                  </p>
                  <p>
                    Contame cómo anda por allá, y si el mate sigue ganándole al café.
                  </p>
                </div>

                <p class="font-serif-literary italic text-slate-500 text-lg text-right mt-8">Un abrazo grande.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- --- 5. Cómo funciona --- -->
    <section class="py-24 bg-[#FCF9F5] border-y border-orange-100/50 sr-fade-up">
      <div class="contenedor">
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
          <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Paso a paso</span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-2 mb-4">
            Cómo funciona el intercambio de cartas
          </h2>
          <p class="text-xl text-slate-600 leading-relaxed text-pretty">
            Del formulario a la primera carta, el equipo acompaña cada paso.
            Lo que ponés vos son las palabras.
          </p>
        </div>

        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
          {pasos.map((paso, i) => (
            <li class="relative text-center sr-fade-up-delayed">
              <!-- Hilo punteado entre pasos: el recorrido postal de la carta. Arranca al borde del
                   círculo y termina antes del siguiente, con el círculo centrado en la columna. -->
              {i < pasos.length - 1 && (
                <span class="hidden lg:block absolute top-7 left-[calc(50%+2.25rem)] right-[calc(-50%+0.25rem)] border-t-2 border-dashed border-[#A65F4C]/25" aria-hidden="true"></span>
              )}
              <div class="w-14 h-14 mx-auto rounded-full bg-[#A65F4C] text-white flex items-center justify-center text-xl font-black mb-6">
                {i + 1}
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3 text-balance">{paso.title}</h3>
              <p class="text-slate-600 leading-relaxed font-light text-pretty">{paso.text}</p>
            </li>
          ))}
        </ol>

        <p class="text-center text-lg text-slate-600 mt-16 max-w-2xl mx-auto">
          ¿Querés escribir?{' '}
          <a href="/voluntariado-adultos-mayores/" class="font-bold text-[#A65F4C] hover:text-[#DD8574] transition-colors underline decoration-2 underline-offset-4">Mirá las formas de participar</a>.
          Si representás una residencia, un hogar, una escuela o una empresa,{' '}
          <a href="/instituciones-residencias/" class="font-bold text-[#A65F4C] hover:text-[#DD8574] transition-colors underline decoration-2 underline-offset-4">sumá tu institución</a>.
        </p>
      </div>
    </section>

    <!-- --- 6. Resumen / Explorá el proyecto --- -->
    <section class="py-24 bg-white relative sr-fade-up">
      <div class="contenedor">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Explorá Puentes de Papel</span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-2 mb-4">
            ¿Por dónde querés empezar?
          </h2>
          <p class="text-xl text-slate-600 leading-relaxed">
            Conocé la iniciativa, descubrí cómo sumarte, trabajá con nosotros desde tu institución o seguí nuestras novedades.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {secciones.map((s) => (
            <a href={s.href} class="group block sr-fade-up-delayed">
              <Card variant="modern" class="bg-[#FCF9F5] h-full flex flex-col text-left hover:border-[#DD8574]/30">
                <div class="w-14 h-14 rounded-2xl bg-white border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-5 group-hover:scale-105 transition-transform duration-300">
                  <s.icon class="w-7 h-7" />
                </div>
                <span class="text-xs font-bold text-[#A65F4C] uppercase tracking-wider mb-2">{s.eyebrow}</span>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">{s.title}</h3>
                <p class="text-slate-600 text-lg leading-relaxed font-light flex-1">{s.text}</p>
                <span class="mt-6 inline-flex items-center gap-2 font-bold text-[#A65F4C] group-hover:gap-3 transition-all">
                  Ir a la sección
                  <ArrowRight class="w-5 h-5" />
                </span>
              </Card>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- --- 7. Franja de impacto --- -->
    <section class="py-20 bg-[#FCF9F5] border-y border-orange-100/50 sr-fade-up">
      <div class="contenedor">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 text-center">
          {impacto.map((dato) => (
            <div>
              <div class="w-14 h-14 mx-auto rounded-2xl bg-white border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-4">
                <dato.icon class="w-7 h-7" />
              </div>
              <p class="text-4xl font-black text-slate-900">{dato.valor}</p>
              <p class="text-sm font-bold text-slate-500 uppercase tracking-wide mt-1 text-balance">{dato.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- --- 8. Últimas noticias --- -->
    {ultimasNoticias.length > 0 && (
      <section class="py-24 bg-white sr-fade-up">
        <div class="contenedor">
          <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Novedades</span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-2 mb-4">
              Últimas noticias
            </h2>
            <p class="text-xl text-slate-600 leading-relaxed text-pretty">
              Lo último del proyecto: encuentros, apariciones en prensa e historias que dejan las cartas.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {ultimasNoticias.map((post) => <NoticiaCard post={post} />)}
          </div>

          <p class="text-center mt-14">
            <a href="/noticias/" class="inline-flex items-center gap-2 font-bold text-[#A65F4C] hover:text-[#DD8574] hover:gap-3 transition-all">
              Ver todas las noticias
              <ArrowRight class="w-5 h-5" />
            </a>
          </p>
        </div>
      </section>
    )}

    <!-- --- 9. Final Call to Action --- -->
    <section class="py-24 bg-white">
      <div class="contenedor">
        <div class="bg-[#A65F4C] rounded-[3rem] p-8 md:p-24 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-white opacity-5 rounded-full transform translate-x-1/2 -translate-y-1/2"></div>
          <div class="absolute bottom-0 left-0 w-80 h-80 bg-white opacity-5 rounded-full transform -translate-x-1/2 translate-y-1/2"></div>

          <div class="relative z-10 max-w-3xl mx-auto">
            <h2 class="text-4xl md:text-5xl font-black text-white mb-6">
              Sé parte de Puentes de Papel
            </h2>
            <p class="text-xl text-[#F2EADD] mb-10 leading-relaxed">
              Si te interesa participar como voluntario o conoces a una persona mayor que quiera compartir sus historias, sumate al programa. Conocé todas las <a href="/voluntariado-adultos-mayores/" class="underline decoration-2 underline-offset-4 hover:text-white transition-colors">formas de participar</a>.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
              <a
                href={FORMS.voluntarios}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-amber-400 text-[#3B1E16] text-lg md:text-xl font-bold px-8 md:px-10 py-4 md:py-5 rounded-full hover:bg-amber-300 hover:-translate-y-1 transition-all duration-300 inline-flex items-center gap-3"
              >
                Quiero ser voluntario/a
                <Send class="w-5 h-5" />
              </a>
              <a
                href={FORMS.adultosMayores}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-white text-[#A65F4C] text-lg md:text-xl font-bold px-8 md:px-10 py-4 md:py-5 rounded-full hover:bg-[#F2EADD] hover:-translate-y-1 transition-all duration-300 inline-flex items-center gap-3"
              >
                Quiero participar como adulto mayor
                <Send class="w-5 h-5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Renglones de la carta simulada. El paso de 2rem tiene que coincidir con leading-8 del texto. */
  .papel-carta {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(2rem - 1px),
      rgb(166 95 76 / 0.14) calc(2rem - 1px),
      rgb(166 95 76 / 0.14) 2rem
    );
    background-position: 0 0.45rem;
  }
</style>
