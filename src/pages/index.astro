---
import { Image } from 'astro:assets';
import { Heart, Users, MessageCircle, BookOpen, Star, Sparkles, ArrowRight, UserPlus, Send, Menu, Mail, Clock, PenTool, Building, Coins, Printer, Truck, Megaphone, Gift, Wallet, CreditCard, ChevronDown } from 'lucide-astro';
import BaseLayout from '../components/BaseLayout.astro';
import Card from '../components/Card.astro';

const title = 'Puentes de Papel - Munay Ruray';
const description = 'Conectando generaciones a través de historias y memorias. Puentes de Papel une a jóvenes voluntarios con personas mayores para compartir historias de vida, rescatar memorias y generar vínculos significativos.';
const ogImage = new URL('/images/puentes-de-papel-conversacion-parque-adulto-mayor-voluntaria.webp', Astro.site || 'https://puentesdepapel.munayruray.com');
---

<BaseLayout 
  title={title} 
  description={description} 
  ogImage={ogImage.toString()}
  showScrollProgress={true}
  showAnimations={true}
>
  <!-- JSON-LD: Organización y WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": "Munay Ruray",
        "url": "https://munayruray.com"
      },
      {
        "@type": "WebSite",
        "name": "Puentes de Papel",
        "alternateName": "Puentes de Papel - Munay Ruray",
        "url": String(Astro.url.href),
        "description": description,
        "publisher": { "@id": "https://munayruray.com" },
        "inLanguage": "es-PE"
      }
    ]})} />

  <div class="min-h-screen font-sans text-slate-800 overflow-hidden" style="font-family: 'Nunito', sans-serif;">
    <div class="bg-[#F2EADD]">
        <!-- --- Navigation Bar (Optional but good for context) --- -->
        <header class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl py-6 relative z-10 animate-slide-down">
          <div class="flex justify-between items-center">
            <div class="flex items-center gap-2">
              <div class="w-48 bg-transparent flex items-center justify-center">
                <Image src="/images/logo-horizontal.png" width={192} height={48} alt="Logo de Puentes de Papel" class="w-full h-full object-cover mix-blend-multiply" />
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="hidden md:flex gap-8 font-semibold text-slate-600">
                <a href="#sobre-el-proyecto" class="hover:text-[#A65F4C] transition-colors">Sobre el proyecto</a>
                <a href="#como-funciona" class="hover:text-[#A65F4C] transition-colors">¿Cómo funciona?</a>
                <a href="#formas-de-participar" class="hover:text-[#A65F4C] transition-colors">Formas de participar</a>
                <a href="#quienes-somos" class="hover:text-[#A65F4C] transition-colors">Quiénes somos</a>
              </div>
              <label
                for="alternar-menu"
                class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-full bg-white shadow-sm border border-slate-200 text-slate-700 hover:bg-[#F2EADD] hover:text-[#A65F4C] transition-colors cursor-pointer"
                aria-label="Abrir menú de navegación"
              >
                <Menu class="w-6 h-6" />
              </label>
            </div>
          </div>
          <input id="alternar-menu" type="checkbox" class="peer hidden" />
          <nav class="mt-4 bg-white rounded-2xl shadow-lg p-4 space-y-3 peer-checked:block hidden md:hidden">
            <a href="#sobre-el-proyecto" class="block px-2 py-2 rounded-xl font-semibold text-slate-700 hover:bg-[#F2EADD] hover:text-[#A65F4C] transition-colors">
              Sobre el proyecto
            </a>
            <a href="#como-funciona" class="block px-2 py-2 rounded-xl font-semibold text-slate-700 hover:bg-[#F2EADD] hover:text-[#A65F4C] transition-colors">
              ¿Cómo funciona?
            </a>
            <a href="#formas-de-participar" class="block px-2 py-2 rounded-xl font-semibold text-slate-700 hover:bg-[#F2EADD] hover:text-[#A65F4C] transition-colors">
              Formas de participar
            </a>
            <a href="#quienes-somos" class="block px-2 py-2 rounded-xl font-semibold text-slate-700 hover:bg-[#F2EADD] hover:text-[#A65F4C] transition-colors">
              Quiénes somos
            </a>
          </nav>
        </header>
  
        <!-- --- 1. Hero Section --- -->
        <section class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl pt-12 pb-24 md:pt-20 md:pb-32 relative animate-fade-slide-up">
          <!-- Decorative Background Blobs -->
          <div class="absolute top-0 left-0 w-96 h-96 bg-[#DD8574] rounded-full mix-blend-multiply filter blur-[128px] opacity-30"></div>
          <div class="absolute top-0 right-0 w-96 h-96 bg-amber-200 rounded-full mix-blend-multiply filter blur-[128px] opacity-40"></div>
  
          <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20 relative z-10">
            
            <!-- Left Column: Text -->
            <div class="w-full md:w-1/2 flex flex-col items-start text-left animate-fade-slide-up" style="animation-delay: 150ms;">
              <div class="inline-flex items-center gap-2 bg-white border border-[#DD8574]/40 px-4 py-2 rounded-full mb-6">
                <span class="flex h-2 w-2 rounded-full bg-[#A65F4C]"></span>
                <span class="text-sm font-bold text-[#A65F4C] tracking-wide uppercase">Un proyecto de Munay Ruray</span>
              </div>
              
              <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-slate-900 leading-[1.1] mb-6">
                Puentes <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#A65F4C] to-[#DD8574]">de Papel</span>
              </h1>
              
              <h2 class="text-xl md:text-2xl font-semibold text-slate-600 mb-6 leading-relaxed">
                Conectando generaciones a través de historias y memorias.
              </h2>
              
              <p class="text-xl text-slate-500 mb-10 leading-relaxed max-w-xl">
                Puentes de Papel es una iniciativa social que promueve vínculos, participación y espacios de encuentro para personas mayores. A través del intercambio de cartas, actividades intergeneracionales y proyectos comunitarios, buscamos construir una sociedad más conectada, humana y amigable con el envejecimiento.
              </p>
              
              <div class="flex flex-col sm:flex-row items-center gap-6 w-full sm:w-auto">
                <a href="#formas-de-participar" class="cursor-pointer w-full sm:w-auto bg-[#A65F4C] text-white text-lg font-bold px-8 py-4 rounded-full hover:bg-[#DD8574] hover:-translate-y-1 transition-all duration-300 btn-shine">
                  Descubre cómo participar
                </a>
                <a href="#como-funciona" class="cursor-pointer w-full sm:w-auto group flex items-center justify-center gap-3 text-slate-700 font-bold text-lg hover:text-[#A65F4C] transition-colors">
                  <div class="w-12 h-12 rounded-full bg-white border border-slate-100 flex items-center justify-center group-hover:bg-[#F2EADD] transition-colors">
                    <Sparkles class="w-5 h-5 text-[#A65F4C]" />
                  </div>
                  Conocer más
                </a>
              </div>
            </div>
  
            <!-- Right Column: Image/Illustration -->
            <div class="w-full md:w-1/2 relative animate-hero-img-in mt-10 md:mt-0" style="animation-delay: 300ms;">
              <!-- Floating decorative elements -->
              <div class="absolute -top-4 -left-2 md:-top-8 md:-left-8 bg-white border border-slate-100 p-2.5 md:p-3 rounded-2xl z-20">
                <Sparkles class="w-6 h-6 md:w-8 md:h-8 text-amber-400" />
              </div>
              <div class="absolute -bottom-4 -right-2 md:-bottom-6 md:-right-6 bg-white border border-slate-100 p-3 md:p-4 rounded-full z-20">
                <Heart class="w-6 h-6 md:w-8 md:h-8 text-rose-400 fill-rose-400" />
              </div>

              <!-- Main Image Masked -->
              <div class="relative rounded-[2rem] md:rounded-[3rem] overflow-hidden border-4 md:border-8 border-white">
                <div class="absolute inset-0 bg-[#A65F4C]/10 mix-blend-overlay z-10"></div>
                <Image
                  src="/images/puentes-de-papel-conversacion-parque-adulto-mayor-voluntaria.webp"
                  width={600}
                  height={500}
                  alt="Un adulto mayor y una joven voluntaria conversan animadamente sentados en una banca de parque durante una sesión del proyecto Puentes de Papel"
                  title="Joven voluntaria conversando con adulto mayor en parque — Puentes de Papel"
                  aria-label="Encuentro intergeneracional al aire libre en el proyecto Puentes de Papel de Munay Ruray, donde jóvenes escuchan y acompañan a personas mayores en el rescate de sus memorias."
                  role="img"
                  class="w-full h-[300px] sm:h-[400px] md:h-[500px] object-cover object-center transform hover:scale-105 transition-transform duration-700"
                />
              </div>
            </div>
  
          </div>
        </section>
      </div>

      <!-- --- 2. About Section --- -->
      <section id="sobre-el-proyecto" class="py-24 bg-white relative sr-fade-up">
        <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl">
          <div class="flex flex-col md:flex-row items-center gap-16">
            
            <!-- Left Image -->
            <div class="w-full md:w-5/12 relative">
               <div class="absolute -inset-4 bg-amber-100 rounded-[3rem] transform rotate-3 z-0"></div>
               <Image 
                 src="/images/puentes-de-papel-grupo-voluntarios-adultos-mayores-historias.webp" 
                 width={500}
                 height={450}
                 alt="Dos adultos mayores y dos jóvenes voluntarios reunidos alrededor de una mesa con papeles y libretas, compartiendo memorias en el proyecto Puentes de Papel"
                 title="Grupo de voluntarios y adultos mayores compartiendo historias en Puentes de Papel"
                 aria-label="Sesión grupal del proyecto Puentes de Papel de Munay Ruray, promoviendo el vínculo intergeneracional a través del diálogo, la escucha activa y la escritura colaborativa."
                 role="img"
                 class="relative z-10 w-full h-[450px] object-cover rounded-[2.5rem]"
               />
               <div class="absolute bottom-8 -right-8 bg-white border border-slate-100 px-6 py-4 rounded-2xl z-20 flex items-center gap-4">
                 <div class="bg-green-100 p-3 rounded-full">
                   <Users class="w-6 h-6 text-green-600" />
                 </div>
                 <div>
                   <p class="font-extrabold text-slate-900 text-xl">+500</p>
                   <p class="text-xs font-bold text-slate-500 uppercase">Voluntarios</p>
                 </div>
               </div>
            </div>

            <!-- Right Text -->
            <div class="w-full md:w-7/12">
              <h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-8">
                Sobre Puentes de Papel
              </h2>
              <div class="space-y-6 text-xl text-slate-600 leading-relaxed">
                <p>
                  <span class="font-bold text-[#A65F4C]">Puentes de Papel</span> nació con el objetivo de conectar generaciones a través del intercambio de cartas entre jóvenes y personas mayores.
                </p>
                <p>
                  Con el tiempo, el proyecto fue creciendo y ampliando su alcance, incorporando nuevas iniciativas orientadas al acompañamiento, la participación activa y la construcción de vínculos significativos para las personas mayores.
                </p>
                <p>
                  Hoy trabajamos junto a residencias, instituciones educativas, organizaciones sociales y distintos espacios comunitarios para generar experiencias que promuevan el encuentro entre generaciones y una mirada más humana sobre el envejecimiento.
                </p>
              </div>
            </div>

          </div>

          <!-- Misión y Visión Section -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mt-20">
            <!-- Misión Card -->
            <Card variant="modern" hoverEffect={false} class="bg-[#FCF9F5] border-[#A65F4C]/5 p-10 md:p-12 hover:shadow-md">
              <div class="absolute -right-20 -top-20 w-48 h-48 bg-[#A65F4C]/5 rounded-full filter blur-xl group-hover:scale-110 transition-transform duration-500"></div>
              <div class="flex items-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center text-[#A65F4C]">
                  <Send class="w-7 h-7" />
                </div>
                <h3 class="text-3xl font-black text-slate-900">Misión</h3>
              </div>
              <p class="text-xl text-slate-600 leading-relaxed font-light">
                Generar vínculos intergeneracionales a través del intercambio de cartas, promoviendo la escucha, el acompañamiento emocional y la construcción de comunidades más humanas y conectadas.
              </p>
            </Card>

            <!-- Visión Card -->
            <Card variant="modern" hoverEffect={false} class="bg-[#FCF9F5] border-[#A65F4C]/5 p-10 md:p-12 hover:shadow-md">
              <div class="absolute -right-20 -top-20 w-48 h-48 bg-amber-100/30 rounded-full filter blur-xl group-hover:scale-110 transition-transform duration-500"></div>
              <div class="flex items-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-600">
                  <Star class="w-7 h-7 fill-amber-600/10" />
                </div>
                <h3 class="text-3xl font-black text-slate-900">Visión</h3>
              </div>
              <p class="text-xl text-slate-600 leading-relaxed font-light">
                Aspiramos a construir una comunidad donde las personas mayores tengan cada vez más oportunidades de participación, encuentro y acompañamiento, promoviendo iniciativas que fortalezcan los vínculos humanos, la inclusión social y el envejecimiento activo.
              </p>
            </Card>
          </div>

        </div>
      </section>

      <!-- --- Nuestros Proyectos Section --- -->
      <section id="nuestros-proyectos" class="py-24 bg-white relative sr-fade-up">
        <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl">
          <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Nuestros proyectos</span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-2 mb-4">
              Una organización en crecimiento
            </h2>
            <p class="text-xl text-slate-600 leading-relaxed">
              Puentes de Papel fue ampliando su alcance con distintas líneas de acción orientadas al encuentro entre generaciones y al bienestar de las personas mayores.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <!-- Proyecto principal -->
            <Card variant="modern" class="bg-[#F2EADD]/60 flex flex-col text-left hover:border-[#DD8574]/30">
              <div class="w-14 h-14 rounded-2xl bg-white border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-5">
                <Mail class="w-7 h-7" />
              </div>
              <span class="text-xs font-bold text-[#A65F4C] uppercase tracking-wider mb-2">Proyecto principal</span>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Puentes de Papel</h3>
              <p class="text-slate-600 text-lg leading-relaxed font-light">
                Programa de intercambio de cartas entre jóvenes y personas mayores que promueve vínculos intergeneracionales a través de la escritura, la escucha y el acompañamiento.
              </p>
            </Card>

            <!-- Proyecto institucional -->
            <Card variant="modern" class="bg-white flex flex-col text-left hover:border-[#DD8574]/30">
              <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-center text-[#A65F4C] mb-5">
                <Heart class="w-7 h-7" />
              </div>
              <span class="text-xs font-bold text-[#A65F4C] uppercase tracking-wider mb-2">Proyecto institucional</span>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Envejecer</h3>
              <p class="text-slate-600 text-lg leading-relaxed font-light">
                Espacio orientado a acompañar, reflexionar y visibilizar distintas experiencias vinculadas al proceso de envejecimiento, promoviendo el bienestar, la participación activa y una mirada positiva sobre esta etapa de la vida.
              </p>
            </Card>

            <!-- Proyectos con instituciones educativas -->
            <Card variant="modern" class="bg-white flex flex-col text-left hover:border-[#DD8574]/30">
              <div class="w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-[#A65F4C] mb-5">
                <Users class="w-7 h-7" />
              </div>
              <span class="text-xs font-bold text-[#A65F4C] uppercase tracking-wider mb-2">Con instituciones educativas</span>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Puentes entre generaciones</h3>
              <p class="text-slate-600 text-lg leading-relaxed font-light">
                Propuesta que vincula instituciones educativas con residencias, hogares y espacios de personas mayores mediante actividades de intercambio, escritura, diálogo y aprendizaje compartido.
              </p>
            </Card>

            <!-- Proyectos futuros -->
            <Card variant="modern" class="bg-[#FCF9F5] flex flex-col text-left border-dashed border-[#A65F4C]/20 hover:border-[#DD8574]/40">
              <div class="w-14 h-14 rounded-2xl bg-white border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-5">
                <Sparkles class="w-7 h-7" />
              </div>
              <span class="text-xs font-bold text-[#A65F4C] uppercase tracking-wider mb-2">Próximamente</span>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Nuevas iniciativas</h3>
              <p class="text-slate-600 text-lg leading-relaxed font-light">
                Seguimos preparando nuevas iniciativas, talleres, actividades comunitarias y alianzas institucionales para ampliar el impacto del proyecto.
              </p>
            </Card>
          </div>
        </div>
      </section>

      <!-- --- Nuestra Esencia Section --- -->
      <section class="py-24 bg-[#FCF9F5] border-y border-orange-100/50 relative sr-fade-up">
        <!-- Background decorative floating elements -->
        <div class="absolute right-10 top-10 text-orange-200/25 pointer-events-none select-none">
          <BookOpen class="w-20 h-20" />
        </div>
        
        <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl">
          <!-- Section Title -->
          <div class="text-center mb-16">
            <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Nuestra esencia</span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-2 mb-4">
              El alma de Puentes de Papel
            </h2>
            <div class="w-16 h-1 bg-[#DD8574] rounded-full mx-auto"></div>
          </div>
          
          <!-- Staggered Layered Letter Card for the Manifesto Quote -->
          <div class="relative max-w-4xl mx-auto mb-20 sr-fade-up-delayed">
            <!-- Background sheet 2 (deepest) -->
            <div class="absolute inset-0 bg-[#F5EFE6] rounded-[2rem] shadow-sm transform -rotate-1.5 translate-y-1"></div>
            <!-- Background sheet 1 (middle) -->
            <div class="absolute inset-0 bg-[#FAF7F2] rounded-[2rem] shadow-md transform rotate-1 translate-y-0.5"></div>
            
            <!-- Main Letter Sheet (top) -->
            <div class="relative bg-[#FDFDFB] rounded-[2rem] p-8 md:p-16 lg:p-20 shadow-xl border border-[#EBE3D5] transform rotate-[-0.5deg] overflow-hidden">
              <!-- Vintage double line border framing the letter -->
              <div class="absolute inset-3 border border-[#A65F4C]/15 pointer-events-none rounded-[1.8rem]"></div>
              <div class="absolute inset-4 border border-dashed border-[#A65F4C]/10 pointer-events-none rounded-[1.7rem]"></div>
              
   
              <!-- Big Letter Quote in Garamond serif -->
              <div class="relative z-10 max-w-2xl mx-auto">
                <span class="text-6xl font-serif-literary text-[#DD8574]/20 absolute -top-8 -left-8 md:-left-12 select-none">“</span>
                <p class="font-serif-literary text-2xl md:text-3xl text-slate-800 leading-relaxed font-medium italic text-center text-pretty">
                  Creemos en el poder de las palabras para acercar personas que, tal vez, nunca se hubieran encontrado. Puentes de Papel nace para transformar la distancia en compañía y las cartas en vínculos reales. En un mundo cada vez más rápido, apostamos por volver a mirar al otro con tiempo, escucha y humanidad.
                </p>
                <span class="text-6xl font-serif-literary text-[#DD8574]/20 absolute -bottom-16 -right-6 select-none">”</span>
                
                <!-- Separator line -->
                <div class="w-32 h-[1px] bg-gradient-to-r from-transparent via-[#A65F4C]/20 to-transparent mx-auto my-8"></div>
                
                <!-- Calligraphic signature and seal -->
                <div class="flex items-center justify-between mt-6">
                  <!-- Wax Seal Graphic / Medalla with logo.webp -->
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-full overflow-hidden border border-[#A65F4C]/20 shadow-inner flex items-center justify-center bg-white">
                      <Image src="/images/logo.webp" width={40} height={40} alt="Sello de Puentes de Papel" class="w-10 h-10 object-contain" />
                    </div>
                    <span class="text-xs uppercase tracking-widest text-slate-400 font-bold select-none">Manifiesto Colectivo</span>
                  </div>
                  
                  <!-- Handwritten Signature using Horizontal Logo -->
                  <div class="text-right flex flex-col items-end">
                    <Image src="/images/logo-horizontal.png" width={160} height={40} alt="Logo de Puentes de Papel" class="h-10 object-contain mix-blend-multiply opacity-80" />
                    <span class="text-[10px] uppercase tracking-widest text-[#DD8574] font-bold mt-1 mr-2">
                      Munay Ruray
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- The 6 Pillars (designed as clean cards matching the site's design language, with text-xl size) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Pillar 1 -->
            <div class="sr-stagger-item" style="transition-delay: 0ms;">
              <Card variant="modern" class="bg-white border-slate-100 p-8 h-full flex flex-col justify-between">
                <div>
                  <div class="w-12 h-12 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform duration-300">
                    <Heart class="w-6 h-6 text-[#A65F4C] fill-[#A65F4C]/10" />
                  </div>
                  <h3 class="font-bold text-slate-900 text-2xl mt-6 mb-3">Combatir la soledad</h3>
                  <p class="text-slate-600 text-xl leading-relaxed">Creamos compañía en las horas silenciosas, llevando palabras que abrigan y acompañan.</p>
                </div>
              </Card>
            </div>

            <!-- Pillar 2 -->
            <div class="sr-stagger-item" style="transition-delay: 80ms;">
              <Card variant="modern" class="bg-white border-slate-100 p-8 h-full flex flex-col justify-between">
                <div>
                  <div class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform duration-300">
                    <Users class="w-6 h-6 text-amber-600" />
                  </div>
                  <h3 class="font-bold text-slate-900 text-2xl mt-6 mb-3">Vínculos reales</h3>
                  <p class="text-slate-600 text-xl leading-relaxed">No es un contacto efímero; es una relación de cariño y respeto que se siembra mes a mes.</p>
                </div>
              </Card>
            </div>

            <!-- Pillar 3 -->
            <div class="sr-stagger-item" style="transition-delay: 160ms;">
