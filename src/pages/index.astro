---
import { Image } from 'astro:assets';
import { Heart, Users, Building, Newspaper, BookOpen, Sparkles, ArrowRight, Send } from 'lucide-astro';
import BaseLayout from '../components/BaseLayout.astro';
import Card from '../components/Card.astro';
import { FORMS } from '../consts';

const title = 'Puentes de Papel - Munay Ruray';
const description = 'Conectando generaciones a través de historias y memorias. Puentes de Papel une a jóvenes voluntarios con personas mayores para compartir historias de vida, rescatar memorias y generar vínculos significativos.';
const ogImage = new URL('/images/puentes-de-papel-conversacion-parque-adulto-mayor-voluntaria.webp', Astro.site || 'https://puentesdepapel.munayruray.com');

// Tarjetas de navegación hacia las páginas principales.
const secciones = [
  {
    href: '/sobre-el-proyecto',
    icon: BookOpen,
    eyebrow: 'Conocé la iniciativa',
    title: 'Sobre el proyecto',
    text: 'Nuestra historia, misión, valores y el equipo que sostiene cada carta y cada encuentro.',
  },
  {
    href: '/formas-de-participar',
    icon: Heart,
    eyebrow: 'Sumate',
    title: 'Formas de participar',
    text: 'Voluntariado, participación como persona mayor, donaciones y otras maneras de colaborar.',
  },
  {
    href: '/instituciones',
    icon: Building,
    eyebrow: 'Trabajemos juntos',
    title: 'Instituciones',
    text: 'Residencias, hogares, escuelas, empresas y organizaciones que quieren construir puentes.',
  },
  {
    href: '/noticias',
    icon: Newspaper,
    eyebrow: 'Novedades',
    title: 'Noticias',
    text: 'Encuentros, historias y novedades de nuestra comunidad intergeneracional.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage.toString()}
  showScrollProgress={true}
  showAnimations={true}
>
  <!-- JSON-LD: Organización y WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": "Munay Ruray",
        "url": "https://munayruray.com"
      },
      {
        "@type": "WebSite",
        "name": "Puentes de Papel",
        "alternateName": "Puentes de Papel - Munay Ruray",
        "url": String(Astro.url.href),
        "description": description,
        "publisher": { "@id": "https://munayruray.com" },
        "inLanguage": "es-PE"
      }
    ]})} />

  <div class="font-sans text-slate-800 overflow-hidden" style="font-family: 'Nunito', sans-serif;">
    <!-- --- 1. Hero Section --- -->
    <div class="bg-[#F2EADD]">
      <section class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl pt-12 pb-24 md:pt-20 md:pb-32 relative animate-fade-slide-up">
        <!-- Decorative Background Blobs -->
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#DD8574] rounded-full mix-blend-multiply filter blur-[128px] opacity-30"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-amber-200 rounded-full mix-blend-multiply filter blur-[128px] opacity-40"></div>

        <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20 relative z-10">

          <!-- Left Column: Text -->
          <div class="w-full md:w-1/2 flex flex-col items-start text-left animate-fade-slide-up" style="animation-delay: 150ms;">
            <div class="inline-flex items-center gap-2 bg-white border border-[#DD8574]/40 px-4 py-2 rounded-full mb-6">
              <span class="flex h-2 w-2 rounded-full bg-[#A65F4C]"></span>
              <span class="text-sm font-bold text-[#A65F4C] tracking-wide uppercase">Un proyecto de Munay Ruray</span>
            </div>

            <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-slate-900 leading-[1.1] mb-6">
              Puentes <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#A65F4C] to-[#DD8574]">de Papel</span>
            </h1>

            <h2 class="text-xl md:text-2xl font-semibold text-slate-600 mb-6 leading-relaxed">
              Conectando generaciones a través de historias y memorias.
            </h2>

            <p class="text-xl text-slate-500 mb-10 leading-relaxed max-w-xl">
              Puentes de Papel es una iniciativa social que promueve vínculos, participación y espacios de encuentro para personas mayores. A través del intercambio de cartas, actividades intergeneracionales y proyectos comunitarios, buscamos construir una sociedad más conectada, humana y amigable con el envejecimiento.
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-6 w-full sm:w-auto">
              <a href="/formas-de-participar" class="cursor-pointer w-full sm:w-auto bg-[#A65F4C] text-white text-lg font-bold px-8 py-4 rounded-full hover:bg-[#DD8574] hover:-translate-y-1 transition-all duration-300 btn-shine text-center">
                Descubre cómo participar
              </a>
              <a href="/sobre-el-proyecto" class="cursor-pointer w-full sm:w-auto group flex items-center justify-center gap-3 text-slate-700 font-bold text-lg hover:text-[#A65F4C] transition-colors">
                <div class="w-12 h-12 rounded-full bg-white border border-slate-100 flex items-center justify-center group-hover:bg-[#F2EADD] transition-colors">
                  <Sparkles class="w-5 h-5 text-[#A65F4C]" />
                </div>
                Conocer más
              </a>
            </div>
          </div>

          <!-- Right Column: Image/Illustration -->
          <div class="w-full md:w-1/2 relative animate-hero-img-in mt-10 md:mt-0" style="animation-delay: 300ms;">
            <!-- Floating decorative elements -->
            <div class="absolute -top-4 -left-2 md:-top-8 md:-left-8 bg-white border border-slate-100 p-2.5 md:p-3 rounded-2xl z-20">
              <Sparkles class="w-6 h-6 md:w-8 md:h-8 text-amber-400" />
            </div>
            <div class="absolute -bottom-4 -right-2 md:-bottom-6 md:-right-6 bg-white border border-slate-100 p-3 md:p-4 rounded-full z-20">
              <Heart class="w-6 h-6 md:w-8 md:h-8 text-rose-400 fill-rose-400" />
            </div>

            <!-- Main Image Masked -->
            <div class="relative rounded-[2rem] md:rounded-[3rem] overflow-hidden border-4 md:border-8 border-white">
              <div class="absolute inset-0 bg-[#A65F4C]/10 mix-blend-overlay z-10"></div>
              <Image
                src="/images/puentes-de-papel-conversacion-parque-adulto-mayor-voluntaria.webp"
                width={600}
                height={500}
                alt="Un adulto mayor y una joven voluntaria conversan animadamente sentados en una banca de parque durante una sesión del proyecto Puentes de Papel"
                title="Joven voluntaria conversando con adulto mayor en parque — Puentes de Papel"
                aria-label="Encuentro intergeneracional al aire libre en el proyecto Puentes de Papel de Munay Ruray, donde jóvenes escuchan y acompañan a personas mayores en el rescate de sus memorias."
                role="img"
                class="w-full h-[300px] sm:h-[400px] md:h-[500px] object-cover object-center transform hover:scale-105 transition-transform duration-700"
              />
            </div>
          </div>

        </div>
      </section>
    </div>

    <!-- --- 2. Resumen / Explorá el proyecto --- -->
    <section class="py-24 bg-white relative sr-fade-up">
      <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Explorá Puentes de Papel</span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-2 mb-4">
            ¿Por dónde querés empezar?
          </h2>
          <p class="text-xl text-slate-600 leading-relaxed">
            Conocé la iniciativa, descubrí cómo sumarte, trabajá con nosotros desde tu institución o seguí nuestras novedades.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {secciones.map((s) => (
            <a href={s.href} class="group block sr-fade-up-delayed">
              <Card variant="modern" class="bg-[#FCF9F5] h-full flex flex-col text-left hover:border-[#DD8574]/30">
                <div class="w-14 h-14 rounded-2xl bg-white border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-5 group-hover:scale-105 transition-transform duration-300">
                  <s.icon class="w-7 h-7" />
                </div>
                <span class="text-xs font-bold text-[#A65F4C] uppercase tracking-wider mb-2">{s.eyebrow}</span>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">{s.title}</h3>
                <p class="text-slate-600 text-lg leading-relaxed font-light flex-1">{s.text}</p>
                <span class="mt-6 inline-flex items-center gap-2 font-bold text-[#A65F4C] group-hover:gap-3 transition-all">
                  Ir a la sección
                  <ArrowRight class="w-5 h-5" />
                </span>
              </Card>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- --- 3. Franja de impacto --- -->
    <section class="py-20 bg-[#FCF9F5] border-y border-orange-100/50 sr-fade-up">
      <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-5xl">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 text-center">
          <div>
            <div class="w-14 h-14 mx-auto rounded-2xl bg-white border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-4">
              <Users class="w-7 h-7" />
            </div>
            <p class="text-4xl font-black text-slate-900">+500</p>
            <p class="text-sm font-bold text-slate-500 uppercase tracking-wide mt-1">Voluntarios</p>
          </div>
          <div>
            <div class="w-14 h-14 mx-auto rounded-2xl bg-white border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-4">
              <Heart class="w-7 h-7 fill-current" />
            </div>
            <p class="text-4xl font-black text-slate-900">Vínculos</p>
            <p class="text-sm font-bold text-slate-500 uppercase tracking-wide mt-1">Que combaten la soledad</p>
          </div>
          <div>
            <div class="w-14 h-14 mx-auto rounded-2xl bg-white border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-4">
              <Building class="w-7 h-7" />
            </div>
            <p class="text-4xl font-black text-slate-900">Comunidad</p>
            <p class="text-sm font-bold text-slate-500 uppercase tracking-wide mt-1">Residencias e instituciones</p>
          </div>
        </div>
      </div>
    </section>

    <!-- --- 4. Final Call to Action --- -->
    <section class="py-24 bg-white">
      <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl">
        <div class="bg-[#A65F4C] rounded-[3rem] p-8 md:p-24 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-white opacity-5 rounded-full transform translate-x-1/2 -translate-y-1/2"></div>
          <div class="absolute bottom-0 left-0 w-80 h-80 bg-white opacity-5 rounded-full transform -translate-x-1/2 translate-y-1/2"></div>

          <div class="relative z-10 max-w-3xl mx-auto">
            <h2 class="text-4xl md:text-5xl font-black text-white mb-6">
              Sé parte de Puentes de Papel
            </h2>
            <p class="text-xl text-[#F2EADD] mb-10 leading-relaxed">
              Si te interesa participar como voluntario o conoces a una persona mayor que quiera compartir sus historias, sumate al programa. Conocé todas las <a href="/formas-de-participar" class="underline decoration-2 underline-offset-4 hover:text-white transition-colors">formas de participar</a>.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
              <a
                href={FORMS.voluntarios}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-amber-400 text-[#3B1E16] text-lg md:text-xl font-bold px-8 md:px-10 py-4 md:py-5 rounded-full hover:bg-amber-300 hover:-translate-y-1 transition-all duration-300 inline-flex items-center gap-3"
              >
                Quiero ser voluntario/a
                <Send class="w-5 h-5" />
              </a>
              <a
                href={FORMS.adultosMayores}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-white text-[#A65F4C] text-lg md:text-xl font-bold px-8 md:px-10 py-4 md:py-5 rounded-full hover:bg-[#F2EADD] hover:-translate-y-1 transition-all duration-300 inline-flex items-center gap-3"
              >
                Quiero participar como adulto mayor
                <Send class="w-5 h-5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
