---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { ArrowLeft, CalendarDays, ArrowRight } from 'lucide-astro';
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { newsArticleNode, breadcrumbNode } from '../../seo';

export async function getStaticPaths() {
  const posts = await getCollection('noticias', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.title;

// En UTC: pubDate se parsea a medianoche UTC y en UTC-3 se correría un día atrás.
const dateFormatter = new Intl.DateTimeFormat('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// Datos estructurados de la nota: el artículo en sí y la miga de pan.
const path = `/noticias/${post.id}`;
const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Noticias', path: '/noticias' },
  { name: post.data.title, path },
];
const jsonLd = [
  newsArticleNode({
    path,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    image: post.data.image,
    imageAlt: post.data.imageAlt,
  }),
  breadcrumbNode(migas),
];
---

<BaseLayout
  title={title}
  description={post.data.description}
  ogImage={post.data.image}
  ogImageAlt={post.data.imageAlt}
  showAnimations={true}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  jsonLd={jsonLd}
>
  <div class="font-sans text-slate-800">

    <article class="py-16 md:py-20">
      <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-3xl">
        <Breadcrumbs items={migas} />

        <header class="mb-10">
          <p class="inline-flex items-center gap-1.5 text-sm font-bold text-[#A65F4C] uppercase tracking-wider mb-4">
            <CalendarDays class="w-4 h-4" />
            {dateFormatter.format(post.data.pubDate)}
          </p>
          <h1 class="text-4xl md:text-5xl font-black text-slate-900 leading-tight mb-4">{post.data.title}</h1>
          <p class="text-xl text-slate-600 leading-relaxed font-light">{post.data.description}</p>
        </header>

        {post.data.image && post.data.showHeroImage && (
          <div class="rounded-[2rem] overflow-hidden border-4 border-white shadow-md mb-12">
            <Image
              src={post.data.image}
              width={768}
              height={432}
              alt={post.data.imageAlt || post.data.title}
              class="w-full h-auto object-cover"
            />
          </div>
        )}

        <div class="prose-noticia max-w-none text-lg text-slate-700 leading-relaxed space-y-6">
          <Content />
        </div>

        <!-- Interlinking de cierre -->
        <div class="mt-16 pt-10 border-t border-slate-200/70 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/noticias/" class="inline-flex items-center gap-2 text-[#A65F4C] font-bold hover:text-[#DD8574] transition-colors">
            <ArrowLeft class="w-5 h-5" />
            Ver todas las noticias
          </a>
          <a href="/voluntariado-adultos-mayores/" class="inline-flex items-center gap-2 bg-[#A65F4C] text-white font-bold px-6 py-3 rounded-full hover:bg-[#DD8574] hover:-translate-y-0.5 transition-all duration-300 btn-shine">
            Quiero participar
            <ArrowRight class="w-5 h-5" />
          </a>
        </div>
      </div>
    </article>

  </div>
</BaseLayout>
