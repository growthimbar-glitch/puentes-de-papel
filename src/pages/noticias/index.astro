---
import { getCollection } from 'astro:content';
import { Newspaper } from 'lucide-astro';
import BaseLayout from '../../components/BaseLayout.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';

const title = 'Noticias | Proyecto social para adultos mayores en Córdoba';
const description = 'Novedades, encuentros e historias de Puentes de Papel, el proyecto social para adultos mayores que combate la soledad en Córdoba a través de las cartas.';

const posts = (await getCollection('noticias', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title={title}
  description={description}
  showAnimations={true}
>
  <div class="font-sans text-slate-800 overflow-hidden">

    <!-- Encabezado de página -->
    <section class="bg-[#F2EADD] py-16 md:py-20">
      <div class="contenedor text-center">
        <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Novedades</span>
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 mt-2 mb-4">
          Noticias
        </h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
          Encuentros, historias y novedades de nuestra comunidad: un proyecto que combate la
          soledad de los adultos mayores a través del intercambio de cartas.
        </p>
      </div>
    </section>

    <section class="py-24 bg-white">
      <div class="contenedor">
        {posts.length === 0 ? (
          <div class="text-center max-w-xl mx-auto py-16">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-[#FCF9F5] border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-6">
              <Newspaper class="w-8 h-8" />
            </div>
            <h2 class="text-2xl font-bold text-slate-900 mb-3">Muy pronto, nuevas historias</h2>
            <p class="text-lg text-slate-600 leading-relaxed">
              Todavía no publicamos noticias, pero estamos preparando novedades para compartir con vos.
            </p>
          </div>
        ) : (
          <>
          <h2 class="text-3xl md:text-4xl font-black text-slate-900 text-center mb-12">
            Historias de nuestra comunidad
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post) => <NoticiaCard post={post} />)}
          </div>
          </>
        )}
      </div>
    </section>

  </div>
</BaseLayout>
