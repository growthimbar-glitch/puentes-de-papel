---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Newspaper, ArrowRight, CalendarDays } from 'lucide-astro';
import BaseLayout from '../../components/BaseLayout.astro';

// TODO (fase SEO on-page): reescribir title y description definitivos.
const title = 'Noticias - Puentes de Papel';
const description = 'Novedades, encuentros e historias de la comunidad intergeneracional de Puentes de Papel.';

const posts = (await getCollection('noticias', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={title} description={description} showAnimations={true}>
  <div class="font-sans text-slate-800 overflow-hidden" style="font-family: 'Nunito', sans-serif;">

    <!-- Encabezado de página -->
    <section class="bg-[#F2EADD] py-16 md:py-20">
      <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl text-center">
        <span class="text-sm font-bold text-[#A65F4C] tracking-widest uppercase">Novedades</span>
        <h1 class="text-4xl md:text-6xl font-black text-slate-900 mt-2 mb-4">
          Noticias
        </h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
          Encuentros, historias y novedades de nuestra comunidad intergeneracional.
        </p>
      </div>
    </section>

    <section class="py-24 bg-white">
      <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-6xl">
        {posts.length === 0 ? (
          <div class="text-center max-w-xl mx-auto py-16">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-[#FCF9F5] border border-[#A65F4C]/10 flex items-center justify-center text-[#A65F4C] mb-6">
              <Newspaper class="w-8 h-8" />
            </div>
            <h2 class="text-2xl font-bold text-slate-900 mb-3">Muy pronto, nuevas historias</h2>
            <p class="text-lg text-slate-600 leading-relaxed">
              Todavía no publicamos noticias, pero estamos preparando novedades para compartir con vos.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post) => (
              <a href={`/noticias/${post.id}`} class="group block sr-fade-up-delayed">
                <article class="bg-white border border-[#A65F4C]/10 rounded-[2rem] overflow-hidden shadow-sm h-full flex flex-col hover:shadow-md hover:border-[#DD8574]/30 hover:-translate-y-1 transition-all duration-300">
                  {post.data.image && (
                    <div class="aspect-[16/10] overflow-hidden">
                      <Image
                        src={post.data.image}
                        width={480}
                        height={300}
                        alt={post.data.imageAlt || post.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  )}
                  <div class="p-6 flex flex-col flex-1">
                    <p class="inline-flex items-center gap-1.5 text-xs font-bold text-[#A65F4C] uppercase tracking-wider mb-3">
                      <CalendarDays class="w-4 h-4" />
                      {dateFormatter.format(post.data.pubDate)}
                    </p>
                    <h2 class="text-xl font-bold text-slate-900 mb-2 leading-snug">{post.data.title}</h2>
                    <p class="text-slate-600 leading-relaxed font-light flex-1">{post.data.description}</p>
                    <span class="mt-5 inline-flex items-center gap-2 font-bold text-[#A65F4C] group-hover:gap-3 transition-all">
                      Leer nota
                      <ArrowRight class="w-5 h-5" />
                    </span>
                  </div>
                </article>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

  </div>
</BaseLayout>
